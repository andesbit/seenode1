const comprimirImagen = (imagenComoArchivo, porcentajeCalidad=60) =>
{
    return new Promise((resolve, reject) => {
			const $canvas = document.createElement("canvas");
			const imagen = new Image();
            
			imagen.onload = () => {
				$canvas.width = 100;//imagen.width;
				$canvas.height = 100;//imagen.height;
				$canvas.getContext("2d").drawImage(imagen, 0, 0, 100, 100);
                /*CAMBIOS
                const ctx = $canvas.getContext("2d");
                // ⭐ LLENAR CON BLANCO PRIMERO
                ctx.fillStyle = "#FFFFFF"; // Color de fondo blanco
                ctx.fillRect(0, 0, 100, 100);
                    // Luego dibujar la imagen encima
                ctx.drawImage(imagen, 0, 0, 100, 100);
                */ 
				$canvas.toBlob(
					(blob) => {
						if (blob === null) {
							return reject(blob);
						} else {
							resolve(blob);
						}
					},                    
					imagenComoArchivo.type,  // ⭐ Mantener formato original
					porcentajeCalidad / 100
				);
			}
            imagen.src = URL.createObjectURL(imagenComoArchivo);
        })
}

const blobABase64 = (blob) => {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onloadend = () => resolve(reader.result);
    reader.onerror = reject;
    reader.readAsDataURL(blob);
  });
}

