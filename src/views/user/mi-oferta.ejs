async function updateDataSecure(datos, offerId) {  // Recibe el ID como parámetro
    try {
        const datosCifrados = await encryptObject(datos);
        
        const response = await fetch('/user-data/update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                offerId: offerId,  // 🔑 Enviar el ID por separado
                encryptedData: datosCifrados,
                timestamp: Date.now()
            })
        });
        
        if (response.status === 401) {
            redirectToLogin();
            return;
        }
        
        let resp = await response.json();
        console.log("📩 Respuesta del servidor:", resp);
        
        if(resp.success) {
            alert("Los datos fueron guardados");
        }
        return resp;
    } catch (error) {
        console.error('Error:', error);
        throw error;
    }
}

async function encryptObject(obj) {
  const encoder = new TextEncoder();
  const data = encoder.encode(JSON.stringify(obj));

  async function importPublicKey(pem) {
    const binaryDer = Uint8Array.from(atob(pem.replace(/-----[^-]+-----/g, '')), c => c.charCodeAt(0));
    return await crypto.subtle.importKey(
      'spki',
      binaryDer.buffer,
      { name: 'RSA-OAEP', hash: 'SHA-256' },
      true,
      ['encrypt']
    );
  }

  const pKey = await importPublicKey(publicKey); // Usa la variable global
  
  const encrypted = await crypto.subtle.encrypt({ name: 'RSA-OAEP' }, pKey, data);
  
  return btoa(String.fromCharCode(...new Uint8Array(encrypted)));
} 

// Función auxiliar para validar el objeto antes de enviar
function validarYLimpiarObjeto(obj) {
    // Eliminar propiedades undefined/null
    const limpio = Object.fromEntries(
        Object.entries(obj).filter(([_, v]) => v != null)
    );
    
    // Validar que no esté vacío
    if (Object.keys(limpio).length === 0) {
        throw new Error('El objeto no puede estar vacío');
    }
    
    // Validar tamaño máximo (opcional)
    const jsonSize = JSON.stringify(limpio).length;
    if (jsonSize > 10000) { // 10KB máximo
        throw new Error('Objeto demasiado grande');
    }
    
    return limpio;
}

