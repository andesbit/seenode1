                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-save" onclick="update(<%= ID %>)">💾 Guardar</button>
                    <button class="btn btn-cancel" onclick="cancelEdit(<%= ID %>)">❌ Cancelar</button>
                </div>
            </div>
        </div>
    <% }); %>
</div>
</main>

