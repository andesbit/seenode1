<!-- Solo el CSS y las modificaciones para tu index.ejs -->
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* Remover el padding del body y aplicarlo solo al main */
    main {
        background: linear-gradient(135deg, #eaeae4 0%, #e8dab2 100%);
        min-height: 100vh;
        padding: 20px;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    h2 {
        color: white;
        font-size: 2.5em;
        margin-bottom: 30px;
        text-align: center;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .offer-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .offer-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 12px rgba(0,0,0,0.2);
    }

    .offer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f0f0f0;
    }

    .offer-id {
        background: linear-gradient(135deg, #eabe66 0%, #bf4d30 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9em;
    }

    .offer-actions {
        display: flex;
        gap: 10px;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9em;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-edit {
        background-color: #a7b49e;
        color: white;
    }

    .btn-edit:hover {
        background-color: #849485;
        transform: scale(1.05);
    }

    .btn-delete {
        background-color: #df855f;
        color: white;
    }

    .btn-delete:hover {
        background-color: #b6544d;
        transform: scale(1.05);
    }

    .btn-save {
        background-color: #8ab4cd;
        color: white;
    }

    .btn-save:hover {
        background-color: #7aa4bd;
    }

    .btn-cancel {
        background-color: #9e9e9e;
        color: white;
    }

    .btn-cancel:hover {
        background-color: #757575;
    }

    .offer-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
        margin-top: 15px;
    }

    .detail-item {
        padding: 10px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #f0e5ad;
    }

    .detail-label {
        font-weight: bold;
        color: #b2b2b2;
        font-size: 0.85em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #333;
        font-size: 1em;
    }

    .detail-missing {
        color: #999;
        font-style: italic;
    }

    .edit-form {
        display: none;
        background: #e0e8e0;
        padding: 20px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-weight: 600;
        color: #555;
        margin-bottom: 5px;
        font-size: 0.9em;
    }

    .form-group input {
        padding: 10px;
        border: 2px solid #ddd;
        border-radius: 6px;
        font-size: 1em;
        transition: border-color 0.3s ease;
    }

    .form-group input:focus {
        outline: none;
        border-color: #eab166;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    @media (max-width: 768px) {
        main {
            padding: 10px;
        }

        .offer-header {
            flex-direction: column;
            gap: 15px;
        }

        .offer-actions {
            width: 100%;
            justify-content: center;
        }

        .offer-details {
            grid-template-columns: 1fr;
        }
    }
</style>

