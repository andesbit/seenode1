                    </div>
                    <div class="form-group">
                        <label>💼 Oferta</label>
                        <input id="offer_<%= ID %>" type="text" value="<%= o.offer || '' %>">
                    </div>
                    <div class="form-group">
                        <label>🌍 País</label>
                        <input id="country_<%= ID %>" type="text" value="<%= o.country || '' %>">
                    </div>
                    <div class="form-group">
                        <label>🏙️ Ciudad</label>
                        <input id="city_<%= ID %>" type="text" value="<%= o.city || '' %>">
                    </div>
                    <div class="form-group">
                        <label>⭐ Especialidades</label>
                        <input id="espe_<%= ID %>" type="text" value="<%= o.espe || '' %>">
                    </div>
                    <div class="form-group">
                        <label>📝 Extra</label>
                        <input id="extra_<%= ID %>" type="text" value="<%= o.extra || '' %>">
                    </div>
                    <div class="form-group">
                        <label>📝 Cnts</label>
                        <input id="cnts_<%= ID %>" type="text" value="<%= o.cnts || '' %>">
                    </div>
                    <div class="form-group">
