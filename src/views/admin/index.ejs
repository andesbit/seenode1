async function update(i){
    if (!publicKey) {
        alert('La clave de encriptación aún no está lista.');
        return;
    }

    // 🚫 NO incluyas 'id' ni 'created_at' aquí
    let name = document.getElementById(`name_${i}`).value;
    let email = document.getElementById(`email_${i}`).value;
    let offer = document.getElementById(`offer_${i}`).value;
    let city = document.getElementById(`city_${i}`).value;
    let country = document.getElementById(`country_${i}`).value;
    let espe = document.getElementById(`espe_${i}`).value;
    let extra = document.getElementById(`extra_${i}`).value;
    let cnts = document.getElementById(`cnts_${i}`).value;
    let role = document.getElementById(`role_${i}`).value;
    
    // ✅ Solo los campos editables, SIN id ni created_at
    let obj = {
        name, 
        email, 
        offer, 
        city, 
        country, 
        espe, 
        extra, 
        cnts, 
        role
    };
    
    console.log('📤 Datos a enviar (sin id ni created_at):', obj);
    
    try {
        const datosLimpios = validarYLimpiarObjeto(obj);
        
        // 🔑 Enviar el ID por separado en la URL o en el body
        await updateDataSecure(datosLimpios, i); // Pasar el ID como segundo parámetro
        
        alert('✅ Datos actualizados correctamente');
        cancelEdit(i);
    } catch (error) {
        console.error('Error al actualizar:', error);
        alert('Error al guardar los datos: ' + error.message);
    }
}

async function borrar(id) {
    if (!confirm('¿Estás seguro de eliminar esta oferta?')) return;
    
    try {
        const response = await fetch(`/admin/usuarios/${id}?permanente=true`, {
            method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (response.ok) {
            alert(data.mensaje);
            location.reload();
        } else {
            alert('Error: ' + data.error);
        }
    } catch (error) {
        alert('Error al eliminar');
    }
}

