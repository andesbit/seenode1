//===================================================

const buscar = async(valor) => {
    
    const name    = valor;     // document.getElementById('nam').value;
    const espe    = valor;     // document.getElementById('esp').value;
    const country = valor;  // document.getElementById('country').value;
    const city    = valor;     // document.getElementById('city').value;

    const response = await fetch('/search-offer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, espe, country, city })
    });

    let x = await response.json()
    //SIFUNCIONAconsole.log("RSEARCHCRITE>>",x.data)

    if (response.ok) {
        //document.getElementById('message').textContent = 'Search Criteria';
        let r = x.result
        //console.log(r.length)
        //console.log(r[0])
        let k = ""
        for(let index in r){
            //k+=r[index].name
            k += `<div class = "cuadro">
                <div class="rec-lin pname">${r[index].name}</div>
                <div class="rec-lin">${r[index].offer}</div>
                <div class="rec-lin">${r[index].espe}</div>
                <div class="recl-lin">
                    <center><button>&nbsp;&nbsp;Ver...</button></center>
                </div>
             </div>`
        }
        
        document.getElementById('paginacion').style.display = "none";
        document.getElementById('searchTitle').style.display = "block";
        document.getElementById('portaCuadros').style.display = "none";
        document.getElementById('portaResCuad').style.display = "flex";
        document.getElementById('portaResCuad').innerHTML = k;
        document.getElementById('searchBack').style.display = "block";
        
    } else {
        alert('Error en la búsqueda');
    }
}    






        const searchInput = document.getElementById('searchInput');

        // (···º···) const resultDiv = document.getElementById('result');

        // Función que se ejecuta al buscar
        function realizarBusqueda() {
            const searchTerm = searchInput.value.trim();
            
            if (searchTerm === '') {
                resultDiv.textContent = 'Por favor, escribe algo para buscar';
                resultDiv.classList.add('show');
                return;
            }




            buscar(searchTerm)



            /*
            // Aquí puedes agregar tu lógica de búsqueda
            resultDiv.textContent = `Buscando: "${searchTerm}"`;
            resultDiv.classList.add('show');

            // Ejemplo: podrías hacer una llamada a una API aquí
            console.log('Término de búsqueda:', searchTerm);
            
            // Simular resultado
            setTimeout(() => {
                resultDiv.textContent = `Resultados encontrados para: "${searchTerm}"`;
            }, 500);
            */


        }

        // Escuchar el evento Enter en el input
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                realizarBusqueda();
            }
        });

        // Limpiar el resultado cuando se empieza a escribir de nuevo
        searchInput.addEventListener('input', function() {
            if (searchInput.value === '') {
                resultDiv.classList.remove('show');
            }
        });

//====================================================

function toPage(n){    
    window.location.href = `/user-data/pagina/${n}`;
}  

</script>
